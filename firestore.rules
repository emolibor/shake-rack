rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Askılık kodu paylaşılan bir sır gibi çalışır: kodu bilen okur/yazar.
    // Kod en az 6 karakter olsun ki tahmin edilmesin.
    match /racks/{rackId} {
      allow read, write: if rackId.size() >= 6;
    }
  }
}
