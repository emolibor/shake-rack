rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /racks/{rackId} {
      // Anahtarı (belge kimliğini) bilen tek belgeyi okur/yazar.
      allow get, create, update, delete: if rackId.size() >= 6;
      // Listeleme kapalı: kimse tüm askılıkları dökemez.
      allow list: if false;
    }
  }
}
